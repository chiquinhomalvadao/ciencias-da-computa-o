import cmatplotlib.pyplot as plt

categorias = ['laranja', 'maçã', 'melão', 'melancia', 'banana', 'kiwi', 'pera', 'kaki', 'tangirina', 'goiaba']
valores = [4182, 3866, 3842, 4252, 4167,3991, 3837, 3524, 3735, 3424]
cores = plt.cm.viridis([1/10 for i in range(10)])

plt.figure(figsize=(12, 6))
bars = plt.bar(categorias, valores, color=cores, edgecolor='black', linewidth=0.7)

plt.title('performance de vendas por departamento (trimestre)', fontsize=14, fontweight='bold', pad=20)
plt.ylabel('volume (em milhares)', fontsize=12)
plt.grid(axis='y', linestyle='--', alpha=0.7)
for bar in bars:
  yval = bar.get_height()
  plt.text(bar.get_x() + bar.get_width()/2, yval, f'{yval}', ha='center', va= 'bottom', fontweight='bold')
plt.show()

import matplotlib.pyplot as plt

labels = [
    'Concordo plenamente',
    'Concordo parcialmente',
    'Nem concordo e nem discordo',
    'Discordo parcialmente',
    'Discordo plenamente',
    'Não respondeu'
]

tamanhos = [25, 20, 15, 15, 20, 5]

cores = ['#2D6AAF', '#74C69D', '#FFD166', '#EF476F', '#780000', '#ADB5BD']

plt.figure(figsize=(10, 7))

patches, texts = plt.pie(
    tamanhos,
    labels=labels,
    colors=cores,
    startangle=140,
    labeldistance=1.1,
    wedgeprops={'edgecolor': 'white', 'linewidth': 2}
)

for text in texts:
    text.set_fontsize(11)
    text.set_fontweight('bold')

plt.title('Pesquisa de Opinião: Nível de Concordância', fontsize=14, pad=20)
plt.axis('equal')

plt.show()
