qprod = int(input("Quantos produtos você quer cadastrar?\n"))

total = 0
maiscaro = 0
maisbarato = 999999999
nomecaro = ""
nomebarato = ""
maior_q_100 = 0
menor_q_50 = 0

for i in range(qprod):
    print("Produto", i+1)
    nomeprod = input("Qual o nome do produto? ")
    valor = int(input("Qual o valor do produto? "))

    total = total + valor

    if valor > maiscaro:
        maiscaro = valor
        nomecaro = nomeprod

    if valor < maisbarato:
        maisbarato = valor
        nomebarato = nomeprod

    if valor > 100:
        maior_q_100 = maior_q_100 + 1

    if valor < 50:
        menor_q_50 = menor_q_50 + 1

media = total / qprod

print("\nRESULTADO FINAL")
print("Valor total:", total)
print("Média:", media)
print("Produtos maiores que 100:", maior_q_100)
print("Produtos menores que 50:", menor_q_50)
print("Produto mais caro:", nomecaro)
print("Produto mais barato:", nomebarato)
